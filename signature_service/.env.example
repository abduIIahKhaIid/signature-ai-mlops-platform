# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Detection model from the S3 registry written by the training notebook ----
MODEL_SOURCE=s3
MODEL_S3_BUCKET=signatureai-df-detr-models
MODEL_S3_PREFIX=signatureai/detection
# "production" exists only after the notebook's manual promotion cell; use "latest" before that.
MODEL_ALIAS=latest
# Pin an exact version instead of an alias (disables hot reload):
# MODEL_VERSION=v20261109T142002Z-8a4d7444
MODEL_POLL_SECONDS=300

# Local folder instead of S3 (development only):
# MODEL_SOURCE=local
# LOCAL_MODEL_DIR=/models/best_model

# ---- AWS credentials ----
# On EC2 leave these EMPTY and attach an IAM role with s3:GetObject on the bucket.
# Locally, use a key that can only read the model bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---- Uploaded images: shared docker volume (single host) or S3 (multi host) ----
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# UPLOADS_S3_BUCKET=signatureai-df-detr-models
# UPLOADS_S3_PREFIX=signatureai/uploads

# ---- Queue behaviour ----
# Transient errors (network/S3) are retried with exponential backoff, bad images are not.
MAX_RETRIES=3
# Demo only: allows ?simulate_failures=N to show RETRY -> SUCCESS / FAILURE. Keep false in production.
ALLOW_FAILURE_SIMULATION=false

# ---- Inference tuning ----
DETECTION_THRESHOLD=0.5
WORKER_CONCURRENCY=2
TORCH_THREADS=2
API_WORKERS=2
ENABLE_SIMILARITY=true
SIMILARITY_MATCH_THRESHOLD=0.80
# After running notebooks/02_similarity_siamese.ipynb: load the Siamese weights + validated threshold from S3
# SIMILARITY_S3_ALIAS=latest

# ---- Retraining trigger (Phase 10): HF webhook -> GitHub Actions ----
# Leave empty to disable /webhooks/huggingface. See pipeline/README_PIPELINE.md.
HF_WEBHOOK_SECRET=
HF_DATASET_REPO=netsol-signature-detection/Signature-Detection-System
GITHUB_REPO=
GITHUB_TOKEN=
RETRAIN_MODE=smoke
RETRAIN_COOLDOWN_SECONDS=1800

# ---- Observability (https://logfire.pydantic.dev -> project -> write token) ----
LOGFIRE_TOKEN=
