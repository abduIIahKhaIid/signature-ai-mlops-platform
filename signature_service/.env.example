# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Detection model from the S3 registry written by the training notebook ----
MODEL_SOURCE=s3
MODEL_S3_BUCKET=signatureai-df-detr-models
MODEL_S3_PREFIX=signatureai/detection
# Serve "production": only a validation gate or the dashboard (Promote / Roll back) can move it, and workers refuse a
# production alias without a gate record (app/promotion.py). "latest" = newest candidate of any notebook run: only for
# local development. Before switching an existing server, promote once: docs/setup/model_promotion.md
MODEL_ALIAS=production
# Pin an exact version instead of an alias (disables hot reload):
# MODEL_VERSION=v20261109T142002Z-8a4d7444
MODEL_POLL_SECONDS=300

# Local folder instead of S3 (development only):
# MODEL_SOURCE=local
# LOCAL_MODEL_DIR=/models/best_model

# ---- AWS credentials ----
# On EC2 leave these EMPTY and attach an IAM role with s3:GetObject on the bucket.
# Locally, use a key that can only read the model bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---- Uploaded images: shared docker volume (single host) or S3 (multi host) ----
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# UPLOADS_S3_BUCKET=signatureai-df-detr-models
# UPLOADS_S3_PREFIX=signatureai/uploads

# ---- Queue behaviour ----
# Transient errors (network/S3) are retried with exponential backoff, bad images are not.
# Abuse protection: detect/verify jobs per client IP per minute (0 = off). Locust stress tests bypass it with
# ADMIN_TOKEN=<PIPELINE_ADMIN_TOKEN> (sent as X-Admin-Token).
RATE_LIMIT_PER_MINUTE=30
MAX_RETRIES=3
# Demo only: allows ?simulate_failures=N to show RETRY -> SUCCESS / FAILURE. Keep false in production.
ALLOW_FAILURE_SIMULATION=false

# ---- Inference tuning ----
# Decision threshold: boxes below this confidence are not returned (the web app slider starts here too)
DETECTION_THRESHOLD=0.1
WORKER_CONCURRENCY=2
TORCH_THREADS=2
API_WORKERS=2
ENABLE_SIMILARITY=true
SIMILARITY_MATCH_THRESHOLD=0.80
# After running the similarity notebook: load the Siamese weights + validated threshold from S3.
# The worker checks this alias every MODEL_POLL_SECONDS and safely hot-swaps a new validated version.
# Use production when your training flow has a promotion gate; use latest for the current notebook flow.
# SIMILARITY_S3_ALIAS=production
# A release that fails to download / verify / load is not tried again for this many seconds (moving the alias to
# another release is tried at once). Stops a broken alias from re-downloading the weights on every poll.
FAILED_RELEASE_RETRY_SECONDS=3600

# ---- Continuous training (Phase 10): HF webhook -> EC2 pipeline worker -> Kaggle GPU (no GitHub Actions) ----
# See docs/setup/retraining_pipeline.md. Dashboard: http://<EC2-IP>:8000/pipeline
HF_DATASET_REPO=mabdullahkhalid/Signature_Dataset_Detection
# Same value as the "Secret" field of the Hugging Face webhook (recommended).
# Empty = the HF webhook has no secret: unsigned webhooks are accepted (they only trigger a check of HF_DATASET_REPO).
HF_WEBHOOK_SECRET=
# HF read token (the dataset repo is private): huggingface.co -> Settings -> Access Tokens (Read)
HF_TOKEN=
# kaggle.com -> Settings -> API -> Create New Token (username + key from kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Protects the dashboard buttons "Check now" / "Retrain anyway" (any long random string)
PIPELINE_ADMIN_TOKEN=
# full = whole dataset (real retrain) | smoke = 2k images, 1 epoch (quick pipeline proof)
RETRAIN_MODE=full
# Max training epochs (empty = mode default: smoke 1, full 8). The dashboard's "Training epochs" card overrides this.
RETRAIN_EPOCHS=
# Validation gate: deploy only if test mAP@50 >= floor and not more than MAX_REGRESSION below the served model
GATE_MIN_TEST_MAP50=0.75
GATE_MAX_REGRESSION=0.02
# Overfitting check: reject if validation mAP@50 - test mAP@50 is larger than this
GATE_MAX_VAL_TEST_GAP=0.05
# Comet project for retraining runs (the first manual training stays in signature-ai-detection)
COMET_PROJECT=signature-ai-detection-retrain
# Comet API key + workspace: the dashboard reads the run's experiment with them, and they are synced to Kaggle
COMET_API_KEY=
COMET_WORKSPACE=abdullah-khalid
# S3 key for the KAGGLE NOTEBOOK (user signatureai-colab-uploader; Kaggle cannot use the EC2 role).
# With these + COMET_API_KEY + HF_TOKEN set, the Kaggle secrets dataset is refreshed from this file before every run.
NOTEBOOK_AWS_ACCESS_KEY_ID=
NOTEBOOK_AWS_SECRET_ACCESS_KEY=
NOTEBOOK_AWS_REGION=ap-southeast-2
# Fallback check of the HF repo if a webhook is missed (minutes, 0 = webhook only)
PIPELINE_POLL_MINUTES=30
# Alerts (optional; the dashboard toggles choose which fire). Slack or Discord incoming-webhook URL.
# With any channel set you also get one message per dataset upload / HF webhook / "Check now": training started,
# "same dataset, nothing started", blocked, ... (toggle "trigger" on the dashboard, on by default).
# Discord: server settings -> Integrations -> Webhooks -> New webhook -> Copy webhook URL (phone push for free).
ALERT_WEBHOOK_URL=
# Links in alerts point here (default: https://<PUBLIC_HOST> when PUBLIC_HOST is set)
# PUBLIC_URL=https://13-236-244-226.sslip.io
# E-mail through SMTP, e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Alert if the Kaggle notebook sends no heartbeat for this many minutes
PIPELINE_STUCK_MINUTES=10

# ---- Observability (https://logfire.pydantic.dev -> project -> write token) ----
LOGFIRE_TOKEN=
