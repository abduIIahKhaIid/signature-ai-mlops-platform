{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "RunDeployCommandOnTheApiInstanceOnly",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": [
                "arn:aws:ec2:ap-southeast-2:433306738386:instance/<INSTANCE_ID>",
                "arn:aws:ssm:ap-southeast-2::document/AWS-RunShellScript"
            ]
        },
        {
            "Sid": "ReadCommandResults",
            "Effect": "Allow",
            "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
            "Resource": "*"
        }
    ]
}
