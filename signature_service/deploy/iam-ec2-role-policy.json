{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListModelRegistry",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::signatureai-df-detr-models",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "signatureai/detection/*",
                        "signatureai/similarity/*"
                    ]
                }
            }
        },
        {
            "Sid": "ReadModels",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::signatureai-df-detr-models/signatureai/detection/*",
                "arn:aws:s3:::signatureai-df-detr-models/signatureai/similarity/*"
            ]
        },
        {
            "Sid": "PipelineDashboardActions",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::signatureai-df-detr-models/signatureai/detection/aliases/*",
                "arn:aws:s3:::signatureai-df-detr-models/signatureai/detection/pipeline_runs/control/*",
                "arn:aws:s3:::signatureai-df-detr-models/signatureai/similarity/aliases/*"
            ]
        },
        {
            "Sid": "EcrLogin",
            "Effect": "Allow",
            "Action": "ecr:GetAuthorizationToken",
            "Resource": "*"
        },
        {
            "Sid": "EcrPullServiceImages",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchGetImage",
                "ecr:GetDownloadUrlForLayer",
                "ecr:BatchCheckLayerAvailability"
            ],
            "Resource": "arn:aws:ecr:ap-southeast-2:433306738386:repository/signatureai"
        },
        {
            "Sid": "ReadProductionDotenv",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": "arn:aws:secretsmanager:ap-southeast-2:433306738386:secret:signatureai/prod/dotenv-*"
        }
    ]
}
