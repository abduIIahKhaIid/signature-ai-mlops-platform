# Copy to infra/aws/aws.env (git-ignored) and fill in for the AWS account you are moving to.
# Used by infra/aws/render_policies.sh and infra/aws/setup_aws.sh.

# ---- Account and region ----
AWS_ACCOUNT_ID=123456789012            # AWS console, top right → account ID (12 digits)
AWS_REGION=ap-southeast-2              # Sydney. Keep the bucket, ECR, secret and EC2 in the SAME region.

# ---- Resource names ----
# S3 bucket names are GLOBAL: a new account needs a new name (e.g. add a suffix).
BUCKET=signatureai-models-CHANGE-ME
ECR_REPO=signatureai
SECRET_ID=signatureai/prod/dotenv

# ---- IAM names (same as the original account, change only if you want) ----
EC2_ROLE=SignatureAI-EC2-Role                  # role + instance profile of the EC2 server
EC2_POLICY=SignatureAI-EC2-ReadModels          # customer managed policy attached to that role
DEPLOYER_USER=signatureai-github-deployer      # IAM user whose key goes into GitHub secrets
DEPLOYER_POLICY=SignatureAI-GitHub-Deploy
NOTEBOOK_USER=signatureai-colab-uploader       # IAM user whose key Colab / Kaggle notebooks use
NOTEBOOK_POLICY=SignatureAI-Notebook-S3

# ---- EC2 (used by "setup_aws.sh ec2") ----
INSTANCE_ID=                                   # filled in automatically after "ec2"; or paste i-0... if you launch by hand
INSTANCE_NAME=signatureai-api
INSTANCE_TYPE=t3.large
KEY_NAME=signatureai-key                       # EC2 key pair for SSH (created if missing, .pem saved to infra/aws/out/)
SECURITY_GROUP=signatureai-api-sg
SSH_CIDR=                                      # your IP for SSH, e.g. 39.45.10.20/32. Empty = no SSH rule (use SSM / Instance Connect)
OPEN_HTTPS=false                               # true = also open 80/443 for Caddy HTTPS (sslip.io)
DISK_GB=30
